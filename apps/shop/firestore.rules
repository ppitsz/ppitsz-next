rules_version = '2';

// The shop reads and writes Firestore only from the server, with the Admin
// SDK, which bypasses these rules. Browsers get no direct access at all:
// buyers in China may not reach Google, and every change to stock or orders
// must go through the server's transactions and checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
