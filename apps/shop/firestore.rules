rules_version = '2';

// Emulator only (firebase.test.json). Never deploy it: the ppitsz project's
// Firestore rules belong to the old website, which reads Firestore from the
// browser (ADR 0013). Our apps don't need rules there: they read and write
// Firestore only from the server, with the Admin SDK, which bypasses them, and
// the old rules name their collections one by one, so ours stay closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
