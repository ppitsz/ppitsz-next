# Copy to .env.local. Development uses the real project, like production:
# without the FIREBASE_* variables every run fails (ADR 0008).

# Firebase: the same project as Forms and PPITSZ Account (ppitsz-next). The
# server is the only Firebase client. FIREBASE_API_KEY is the web config's
# apiKey; the browser never sees any of this.
FIREBASE_PROJECT_ID=ppitsz-next
FIREBASE_STORAGE_BUCKET=ppitsz-next.firebasestorage.app
FIREBASE_API_KEY=
# A service account key: Firebase console › Project settings › Service accounts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SITE_URL=https://shop.ppitshenzhen.org
# The one sign-in for every app (ADR 0008). Unset locally: localhost shares cookies across ports.
SESSION_COOKIE_DOMAIN=.ppitshenzhen.org
ACCOUNT_URL=https://account.ppitshenzhen.org
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron.
CRON_SECRET=
# Optional: a group chat webhook for server errors (see lib/server/alerts.ts).
ALERT_WEBHOOK_URL=
