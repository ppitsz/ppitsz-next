# Copy to .env.local. Development uses the real project, like production:
# without the FIREBASE_* variables every run fails (ADR 0008).

# Firebase: the same project as the shop and Forms (ppitsz-next). The server
# is the only Firebase client. FIREBASE_API_KEY is the web config's apiKey,
# used by the server to check passwords; the browser never sees any of this.
FIREBASE_PROJECT_ID=ppitsz-next
FIREBASE_STORAGE_BUCKET=ppitsz-next.firebasestorage.app
FIREBASE_API_KEY=
# A service account key: Firebase console › Project settings › Service accounts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The one sign-in for every app (ADR 0008). Unset locally: localhost shares cookies across ports.
SESSION_COOKIE_DOMAIN=.ppitshenzhen.org
ACCOUNT_URL=https://account.ppitshenzhen.org
SHOP_URL=https://shop.ppitshenzhen.org
# Unset: no links to Forms (it isn't deployed).
FORMS_URL=https://forms.ppitshenzhen.org

# Password reset emails through Resend, as in Forms.
# Without RESEND_API_KEY, emails are written to .outbox/ instead, and in
# production Firebase sends its own (see README, Production).
RESEND_API_KEY=
MAIL_FROM_DEFAULT="PPIT Shenzhen <noreply@ppitshenzhen.org>"
MAIL_REPLY_TO=
