# Copy to .env.local. Development uses the real project, like production:
# without the FIREBASE_* variables every run fails (ADR 0008).

# Firebase: the ppitsz project, shared with the shop, Forms and the old
# website (ADR 0013). The server is the only Firebase client. FIREBASE_API_KEY
# is the web config's apiKey, used by the server to check passwords; the
# browser never sees any of this.
FIREBASE_PROJECT_ID=ppitsz
FIREBASE_STORAGE_BUCKET=ppitsz.firebasestorage.app
FIREBASE_API_KEY=
# A service account key: Firebase console › Project settings › Service accounts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Where the apps live (ADR 0010): <app>.ppitshenzhen.org on Vercel, the dev
# ports locally. Set only for a deploy on another root, e.g. a preview branch
# at preview.ppitshenzhen.org. Leave it unset locally.
ROOT_DOMAIN=

# Continue with Google (ADR 0011): a Web OAuth client in the ppitsz-next Google
# Cloud project, with http://localhost:3003/auth/google/callback as a redirect
# URI. Without them the button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
