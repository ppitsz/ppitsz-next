# Copy to .env.local. Development uses the real project, like production:
# without the FIREBASE_* variables every run fails (ADR 0008).

# Firebase: the ppitsz project, shared with the shop, PPITSZ Account and the
# old website (ADR 0013). The server is the only Firebase client.
# FIREBASE_API_KEY is the web config's apiKey, used by the server to check
# staff passwords; the browser never sees any of this.
FIREBASE_PROJECT_ID=ppitsz
FIREBASE_STORAGE_BUCKET=ppitsz.firebasestorage.app
FIREBASE_API_KEY=
# A service account key: Firebase console › Project settings › Service accounts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email through Resend, with ppitshenzhen.org verified as a sending domain.
# Without RESEND_API_KEY, emails are written to .outbox/ instead.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_TICKET="PPIT Shenzhen <tickets@ppitshenzhen.org>"
MAIL_FROM_DEFAULT="PPIT Shenzhen <noreply@ppitshenzhen.org>"
MAIL_REPLY_TO=

# Where the apps live (ADR 0010): <app>.ppitshenzhen.org on Vercel, the dev
# ports locally. Set only for a deploy on another root, e.g. a preview branch
# at preview.ppitshenzhen.org. Leave it unset locally.
ROOT_DOMAIN=
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron.
CRON_SECRET=
# Optional: a group chat webhook for server errors (see lib/server/alerts.ts).
ALERT_WEBHOOK_URL=
