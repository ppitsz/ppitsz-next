rules_version = '2';

// The ppitsz project's Firestore rules, for the old website and our apps
// alike (ADR 0013). This is the only copy: deploy from this directory,
// `firebase deploy --only firestore:rules --project ppitsz`.
//
// Our apps (shop, Forms, PPITSZ Account) use the Admin SDK on the server,
// which bypasses these rules, so their collections need no rule: anything
// not matched below is closed to browsers. The rules below are the old
// website's, which reads and writes Firestore from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Nothing is open to signed-out requests on the grounds that they might be
    // the old website's server: since 2026-11-16 its email routes and crons use
    // the Admin SDK, which bypasses these rules (ADR 0016).

    match /adminHistory/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /forms/{formId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /responses/{responseId} {
          allow read: if isAdmin();
          allow create: if isAuthenticated();
          allow update, delete: if false;
      }
    }

    match /applications/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /applicationsCounter/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /users/{userId} {
      // Your own record; admins read everyone's (the admin status page).
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Your own document, once, and never as an admin or with roles: only
      // admins grant `admin`, and `roles` are granted on the server (2026-11-16).
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.get("admin", false) == false
        && !("roles" in request.resource.data);
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["submittedForms", "attendedForms", "lastLogin", "name", "birthday", "cohortYear", "status", "graduated"]) ||
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["roles"]))
      );
    }

    match /emailSends/{document} {
      allow read, create, update, delete: if isAdmin();
    }

    match /birthdayTemplates/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /emailSettings/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // INTERVIEW BOOKING (isolated test + future production)
    // ============================================================
    // Notes:
    // - Clients only READ time slots (for the real-time onSnapshot listener).
    // - All WRITES (booking, cancel, seed) go through API routes using the
    //   Firebase Admin SDK, which bypasses these rules entirely.
    // - Applications collection is already writable by its own user above,
    //   but the interview booking flow updates it via Admin SDK.
    // ============================================================
    match /interviewTimeSlot/{parentId} {
      allow read: if true;
      allow write: if false;

      match /timeSlots/{slotId} {
        allow read: if true;
        allow write: if false;

        match /bookings/{bookingId} {
          allow read: if isAuthenticated() &&
            (resource.data.userId == request.auth.uid || isAdmin());
          allow write: if false;
        }
      }
    }

    match /news/{articleId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
